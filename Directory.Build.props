<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      The one version the repository declares. Every built assembly carries it, and the release
      record reads it from here rather than deriving one. Decided at the Design Gate of the
      AI-economics change as a minor increment: the schema and the boundary change additively, and
      the port members it retires have no consumer outside this solution.
    -->
    <Version>1.4.0</Version>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'MediaCompany.Domain'">
    <Using Include="MediaCompany.Domain" />
  </ItemGroup>
</Project>
